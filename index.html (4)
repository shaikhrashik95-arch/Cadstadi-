<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Advanced 2D & 3D Floor Plan App</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            font-family: Arial, sans-serif;
            background-color: #2c3e50;
            color: white;
            display: flex;
            height: 100vh;
        }
        /* Right Sidebar for Shapes and Tools */
        #sidebar {
            width: 120px;
            background: #34495e;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-y: auto;
            border-left: 2px solid #2c3e50;
            z-index: 10;
            padding-bottom: 60px;
        }
        .tool-btn {
            width: 100%;
            padding: 12px 5px;
            background: #34495e;
            border: none;
            border-bottom: 1px solid #2c3e50;
            color: white;
            cursor: pointer;
            text-align: center;
            font-size: 11px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
        }
        .tool-btn:hover {
            background: #1abc9c;
        }
        .tool-icon {
            font-size: 18px;
        }

        /* Canvas Area */
        #canvas-container {
            flex-grow: 1;
            height: 100vh;
        }

        /* Bottom Toolbar */
        #bottom-bar {
            position: absolute;
            bottom: 0;
            left: 0;
            width: calc(100% - 120px);
            background: #22313f;
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            z-index: 10;
            box-shadow: 0 -2px 5px rgba(0,0,0,0.3);
        }
        .bottom-btn {
            background: transparent;
            border: none;
            color: white;
            cursor: pointer;
            font-size: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
        }
        .bottom-btn:hover {
            color: #1abc9c;
        }
    </style>
</head>
<body>

    <!-- Canvas Container for 2D/3D -->
    <div id="canvas-container"></div>

    <!-- Bottom Toolbar -->
    <div id="bottom-bar">
        <button class="bottom-btn" onclick="undoAction()"><span>↩️</span> Undo</button>
        <button class="bottom-btn" onclick="redoAction()"><span>↪️</span> Redo</button>
        <button class="bottom-btn" onclick="pasteAction()"><span>📋</span> Paste</button>
        <button class="bottom-btn" onclick="toggle3DView()"><span>🎲</span> <span id="view-text">3D</span></button>
        <button class="bottom-btn" onclick="shareApp()"><span>🔗</span> Share</button>
        <button class="bottom-btn" onclick="exportPlan()"><span>📥</span> Export</button>
        <button class="bottom-btn" onclick="openFloors()"><span>🥞</span> Floors</button>
    </div>

    <!-- Right Sidebar (Shapes & Elements) -->
    <div id="sidebar">
        <button class="tool-btn" onclick="addElement('square')">
            <span class="tool-icon">⬜</span> Square
        </button>
        <button class="tool-btn" onclick="addElement('l-shape')">
            <span class="tool-icon">📐</span> L-Shape
        </button>
        <button class="tool-btn" onclick="addElement('u-shape')">
            <span class="tool-icon">🪟</span> U-Shape
        </button>
        <button class="tool-btn" onclick="addElement('t-shape')">
            <span class="tool-icon">🔲</span> T-Shape
        </button>
        <button class="tool-btn" onclick="addElement('wall')">
            <span class="tool-icon">〰️</span> Walls
        </button>
        <button class="tool-btn" onclick="addElement('stairs')">
            <span class="tool-icon">📶</span> Stairs
        </button>
        <button class="tool-btn" onclick="addElement('landing')">
            <span class="tool-icon">⏸️</span> Landing
        </button>
        <button class="tool-btn" onclick="addElement('circular-stairs')">
            <span class="tool-icon">🌀</span> Circular stairs
        </button>
    </div>

    <!-- Three.js Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        let scene, camera, renderer, objects = [];
        let is3D = false;

        function init() {
            const container = document.getElementById('canvas-container');
            
            // Scene
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x3b4a5a);

            // Camera
            camera = new THREE.PerspectiveCamera(75, container.clientWidth / container.clientHeight, 0.1, 1000);
            camera.position.set(0, 0, 10);

            // Renderer
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            container.appendChild(renderer.domElement);

            // Lights
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 0.5);
            dirLight.position.set(10, 20, 15);
            scene.add(dirLight);

            animate();
        }

        // Add 3D Elements based on Sidebar Click
        function addElement(type) {
            let geometry, material, mesh;
            material = new THREE.MeshStandardMaterial({ color: 0x95a5a6, roughness: 0.4 });

            switch(type) {
                case 'square':
                    geometry = new THREE.BoxGeometry(2, 2, 0.3);
                    break;
                case 'l-shape':
                    geometry = new THREE.BoxGeometry(1.5, 3, 0.3);
                    break;
                case 'u-shape':
                    geometry = new THREE.BoxGeometry(2, 2, 0.3);
                    break;
                case 't-shape':
                    geometry = new THREE.BoxGeometry(2, 1.5, 0.3);
                    break;
                case 'wall':
                    geometry = new THREE.BoxGeometry(3, 0.3, 1);
                    break;
                case 'stairs':
                    geometry = new THREE.BoxGeometry(1.5, 2, 0.5);
                    break;
                case 'landing':
                    geometry = new THREE.BoxGeometry(1.5, 1.5, 0.2);
                    break;
                case 'circular-stairs':
                    geometry = new THREE.CylinderGeometry(1, 1, 0.8, 16);
                    break;
                default:
                    geometry = new THREE.BoxGeometry(1, 1, 1);
            }

            mesh = new THREE.Mesh(geometry, material);
            mesh.position.x = (Math.random() - 0.5) * 4;
            mesh.position.y = (Math.random() - 0.5) * 4;
            
            scene.add(mesh);
            objects.push(mesh);
        }

        // Bottom Bar Functions
        function undoAction() {
            if (objects.length > 0) {
                let lastObj = objects.pop();
                scene.remove(lastObj);
            }
        }

        function redoAction() {
            alert("Redo অপশন সক্রিয় আছে।");
        }

        function pasteAction() {
            alert("ক্লিপবোর্ড থেকে অবজেক্ট পেস্ট করা হয়েছে।");
        }

        function toggle3DView() {
            is3D = !is3D;
            document.getElementById('view-text').innerText = is3D ? "2D" : "3D";
            if (is3D) {
                camera.position.set(0, -6, 7);
                camera.rotation.x = Math.PI / 4;
            } else {
                camera.position.set(0, 0, 10);
                camera.rotation.set(0, 0, 0);
            }
        }

        function shareApp() {
            alert("লিংক শেয়ার করার অপশন প্রস্তুত!");
        }

        function exportPlan() {
            alert("আপনার ফ্লোর প্ল্যান এক্সপোর্ট করা হচ্ছে...");
        }

        function openFloors() {
            alert("Floors ম্যানেজমেন্ট প্যানেল ওপেন হয়েছে।");
        }

        function animate() {
            requestAnimationFrame(animate);
            renderer.render(scene, camera);
        }

        window.onload = init;
        window.onresize = () => {
            const container = document.getElementById('canvas-container');
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        };
    </script>
</body>
</html>
